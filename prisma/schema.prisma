// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

// ユーザー情報（会員登録用）
model User {
  id            String   @id @default(cuid())
  nickname      String
  email         String   @unique
  password      String
  birthday      DateTime
  birthTime     String?  // 生まれた時刻
  birthCity     String?  // 生まれた都市
  zodiacDayId   Int?     // 算出された日柱の干支番号（1-60）
  genmeiId      Int?     // 算出された元命（月柱の地支通変星 1-10）
  role          String   @default("user") // "user" | "admin"
  createdAt     DateTime @default(now())

  fortuneHistories FortuneHistory[]
}

// 管理者が占断した対象者の履歴（1人1レコード、名前+生年月日で上書き）
model FortuneHistory {
  id          String   @id @default(cuid())
  adminUserId String
  admin       User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  name        String
  birthday    DateTime
  birthTime   String?
  birthCity   String?
  zodiacDayId Int
  genmeiId    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([adminUserId, name, birthday])
}

// 元命データ（月柱の地支通変星・中心星）
model GenmeiData {
  id          Int      @id
  name        String
  title       String
  description String[]
}

// 60干支のマスターデータ（占い結果用）
model Zodiac {
  id          Int      @id
  name        String
  title       String
  description String[]
}

// 西洋占星術: 2天体アスペクトの解釈（66ペア × 7アスペクト = 462件）
model AspectPairData {
  id          String   @id  // e.g. "sun|moon|conjunction"
  title       String
  description String
}

// 西洋占星術: 3天体の組み合わせ解釈（C(12,3) = 220件）
model AspectTripleData {
  id          String   @id  // e.g. "mars|moon|sun" (PLANET_KEYS順でソート)
  title       String
  description String
}